<%# app/views/cucumber_runner/layouts/cucumber_runner.html.erb %>
<!DOCTYPE html>
<html>
<head>
  <title>Cucumber Runner</title>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "cucumber_runner", media: "all" %>
  <%= javascript_importmap_tags(CucumberRunner.configuration.host_javascript_entry) %>
</head>
<body class="cr-body">
  <header class="cr-topbar">
    <%= link_to "Cucumber Runner", main_app.root_path("/cucumber-runner"), class: "cr-brand" %>
    <%= link_to "← Back to app", main_app.root_path, class: "cr-back" %>
  </header>
  <% if flash[:alert] %><div class="cr-flash cr-flash--alert"><%= flash[:alert] %></div><% end %>
  <% if flash[:notice] %><div class="cr-flash cr-flash--notice"><%= flash[:notice] %></div><% end %>
  <main class="cr-main"><%= yield %></main>
</body>
</html>
