<%# app/views/cucumber_runner/scenarios/show.html.erb %>
<div class="cr-scenario-detail">
  <p><%= link_to "← All scenarios", root_path %></p>

  <header class="cr-feature-header">
    <span class="cr-feature-label">Feature</span>
    <h2 class="cr-feature-name"><%= @scenario[:feature_name] %></h2>
    <% if @scenario[:feature_description].present? %>
      <p class="cr-feature-description"><%= simple_format(@scenario[:feature_description]) %></p>
    <% end %>
  </header>

  <h1><%= @scenario[:name] %></h1>
  <div class="cr-tags">
    <% @scenario[:tags].each do |t| %><span class="cr-tag"><%= t %></span><% end %>
  </div>

  <%= form_with url: runs_path, method: :post, local: true do |f| %>
    <%= f.hidden_field :scenario_id, value: @scenario[:id] %>

    <%
      bg_count = @scenario[:background_steps].to_a.size
      step_offset = 0
    %>

    <% if bg_count > 0 %>
      <h3 class="cr-section-label">Background</h3>
      <ol class="cr-step-list" start="1">
        <% @scenario[:background_steps].each_with_index do |step, i| %>
          <% idx = step_offset + i %>
          <li class="cr-step cr-step--background">
            <label class="cr-bp-toggle" title="Toggle breakpoint">
              <input type="checkbox" name="breakpoints[]" value="<%= idx %>">
              <span class="cr-bp-dot"></span>
            </label>
            <span class="cr-keyword"><%= step[:keyword] %></span>
            <span class="cr-text"><%= step[:text] %></span>
            <%= link_to "src", step_definitions_lookup_path(gherkin: step[:text]),
                        class: "cr-step-src", data: { turbo_frame: "_top" } %>
          </li>
        <% end %>
      </ol>
      <% step_offset = bg_count %>
    <% end %>

    <h3 class="cr-section-label">Scenario steps</h3>
    <ol class="cr-step-list" start="<%= step_offset + 1 %>">
      <% @scenario[:scenario_steps].to_a.each_with_index do |step, i| %>
        <% idx = step_offset + i %>
        <li class="cr-step">
          <label class="cr-bp-toggle" title="Toggle breakpoint">
            <input type="checkbox" name="breakpoints[]" value="<%= idx %>">
            <span class="cr-bp-dot"></span>
          </label>
          <span class="cr-keyword"><%= step[:keyword] %></span>
          <span class="cr-text"><%= step[:text] %></span>
          <%= link_to "src", step_definitions_lookup_path(gherkin: step[:text]),
                      class: "cr-step-src", data: { turbo_frame: "_top" } %>
        </li>
      <% end %>
    </ol>
    <div class="cr-run-bar">
      <label class="cr-speed">
        Speed:
        <%= f.select :step_delay_ms,
                     [["Full speed", 0],
                      ["Quick (0.5s/step)", 500],
                      ["Normal (1s/step)", 1000],
                      ["Slow (2s/step)", 2000],
                      ["Teaching (3s/step)", 3000]],
                     selected: 1000 %>
      </label>
      <%= f.submit "Run scenario", class: "cr-run-btn" %>
    </div>
  <% end %>
</div>
