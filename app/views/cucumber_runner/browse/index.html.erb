<%# app/views/cucumber_runner/browse/index.html.erb %>
<div data-controller="cucumber-runner-browse">
  <h1>Scenarios</h1>

  <input type="search"
         data-cucumber-runner-browse-target="search"
         data-action="input->cucumber-runner-browse#filter"
         placeholder="Search scenarios…"
         class="cr-search">

  <div class="cr-tag-chips" data-cucumber-runner-browse-target="tagChips">
    <% @all_tags.each do |tag| %>
      <button type="button"
              class="cr-tag-chip"
              data-tag="<%= tag %>"
              data-action="click->cucumber-runner-browse#toggleTag"><%= tag %></button>
    <% end %>
  </div>

  <script type="application/json" data-cucumber-runner-browse-target="data">
    <%= raw JSON.generate(
      @features.flat_map { |f|
        f[:scenarios].map { |s|
          {
            id: s[:id],
            name: s[:name],
            featureName: f[:name],
            tags: s[:tags]
          }
        }
      }
    ) %>
  </script>

  <ul class="cr-scenarios" data-cucumber-runner-browse-target="list">
    <% @features.group_by { |f| f[:breadcrumb] }.sort_by { |bc, _| bc.to_s }.each do |breadcrumb, features| %>
      <li class="cr-breadcrumb-group" data-breadcrumb="<%= breadcrumb %>">
        <h2 class="cr-breadcrumb-heading"><%= breadcrumb %></h2>
        <ul class="cr-breadcrumb-features">
          <% features.each do |feature| %>
            <li class="cr-feature">
              <h3><%= feature[:name] %></h3>
              <ul>
                <% feature[:scenarios].each do |scenario| %>
                  <li class="cr-scenario" data-tags="<%= scenario[:tags].join(' ') %>">
                    <%= button_to scenario[:name], runs_path(scenario_id: scenario[:id]),
                                  method: :post, class: "cr-scenario-link",
                                  form: { class: "cr-scenario-form" } %>
                    <% scenario[:tags].each do |t| %><span class="cr-tag"><%= t %></span><% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</div>
